<Project>
    <PropertyGroup>
        <_RhinoConfigPath>$(MSBuildProjectDirectory)\rdbsettings.json</_RhinoConfigPath>
        <_RhinoConfigJson Condition="Exists('$(_RhinoConfigPath)')">$([System.IO.File]::ReadAllText('$(_RhinoConfigPath)'))</_RhinoConfigJson>
        <RhinoSourceParentDirectory Condition="'$(_RhinoConfigJson)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_RhinoConfigJson)', '"SourceParentDirectory"\s*:\s*"([^"]*)"').Groups[1].Value)</RhinoSourceParentDirectory>
        <RhinoSourceParentDirectory Condition="'$(RhinoSourceParentDirectory)' == ''">RhinoContracts</RhinoSourceParentDirectory>
        <RhinoTargetParentDirectory Condition="'$(_RhinoConfigJson)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_RhinoConfigJson)', '"TargetParentDirectory"\s*:\s*"([^"]*)"').Groups[1].Value)</RhinoTargetParentDirectory>
        <RhinoTargetParentDirectory Condition="'$(RhinoTargetParentDirectory)' == ''">RhinoDB</RhinoTargetParentDirectory>
        <RhinoSchemaDescriptorPath Condition="'$(_RhinoConfigJson)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_RhinoConfigJson)', '"SchemaDescriptorPath"\s*:\s*"([^"]*)"').Groups[1].Value)</RhinoSchemaDescriptorPath>
        <RhinoSchemaDescriptorPath Condition="'$(RhinoSchemaDescriptorPath)' == ''">RhinoContracts/Descriptor.json</RhinoSchemaDescriptorPath>
        <DisableContractAutoPreBuild Condition="'$(_RhinoConfigJson)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_RhinoConfigJson)', '"DisableContractAutoPreBuild"\s*:\s*(true|false)').Groups[1].Value)</DisableContractAutoPreBuild>
        <DisableContractAutoPreBuild Condition="'$(DisableContractAutoPreBuild)' == ''">false</DisableContractAutoPreBuild>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="$(RhinoSourceParentDirectory)/**/*.cs" />
        <None Include="$(RhinoSourceParentDirectory)/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(RhinoSchemaDescriptorPath)" Condition="Exists('$(RhinoSchemaDescriptorPath)')" />
        <AdditionalFiles Include="rdbsettings.json" Condition="Exists('rdbsettings.json')" />
    </ItemGroup>
</Project>
