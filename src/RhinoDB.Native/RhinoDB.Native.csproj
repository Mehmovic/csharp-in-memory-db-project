<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <None Include="runtimes\win-x64\native\mdbx.dll" Pack="true" PackagePath="runtimes\win-x64\native\mdbx.dll" Condition="Exists('runtimes\win-x64\native\mdbx.dll')">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Include="runtimes\linux-x64\native\libmdbx.so" Pack="true" PackagePath="runtimes\linux-x64\native\libmdbx.so" Condition="Exists('runtimes\linux-x64\native\libmdbx.so')">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Include="runtimes\osx-x64\native\libmdbx.dylib" Pack="true" PackagePath="runtimes\osx-x64\native\libmdbx.dylib" Condition="Exists('runtimes\osx-x64\native\libmdbx.dylib')">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Include="runtimes\osx-arm64\native\libmdbx.dylib" Pack="true" PackagePath="runtimes\osx-arm64\native\libmdbx.dylib" Condition="Exists('runtimes\osx-arm64\native\libmdbx.dylib')">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
